# LinkedIn credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Optional: LinkedIn API credentials (if using official API)
# LINKEDIN_CLIENT_ID=your_client_id
# LINKEDIN_CLIENT_SECRET=your_client_secret

# OpenAI API key (for nomination detection via LLM)
# If not set, the agent will use keyword-based detection
OPENAI_API_KEY=

# Anthropic API key (alternative LLM provider)
ANTHROPIC_API_KEY=

# Agent settings
CHECK_PERIOD_DAYS=7
MAX_POSTS_PER_CONTACT=10
OUTPUT_FORMAT=console
# OUTPUT_FORMAT options: console, json, html
